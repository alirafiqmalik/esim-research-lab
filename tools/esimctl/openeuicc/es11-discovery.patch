+// ES11 SM-DS discovery: the full round trip against a root SM-DS (default
+// lpa.ds.gsma.com) — challenge → initiateAuthentication → authenticateServer →
+// es11_authenticate_client — returning the SM-DP+ addresses with pending events for
+// this EID. Mirrors lpac's `discovery` applet. Returns a String[] (may be empty) or
+// null on error.
+JNIEXPORT jobjectArray JNICALL
+Java_net_typeblog_lpac_1jni_LpacJni_es11Discovery(JNIEnv *env, jobject thiz, jlong handle,
+                                                  jstring smds_address) {
+    struct euicc_ctx *ctx = (struct euicc_ctx *) handle;
+    const char *smds = (*env)->GetStringUTFChars(env, smds_address, NULL);
+    char **smdp_list = NULL;
+    jobjectArray ret = NULL;
+
+    ctx->http.server_address = (char *) smds;  // borrowed for the calls below
+
+    if (es10b_get_euicc_challenge_and_info(ctx))
+        goto out;
+    if (es9p_initiate_authentication(ctx))
+        goto out;
+    if (es10b_authenticate_server(ctx, NULL, NULL))
+        goto out;
+    if (es11_authenticate_client(ctx, &smdp_list))
+        goto out;
+
+    int n = 0;
+    while (smdp_list && smdp_list[n] != NULL) n++;
+    ret = (*env)->NewObjectArray(env, n, string_class, NULL);
+    for (int i = 0; i < n; i++) {
+        jstring s = toJString(env, smdp_list[i]);
+        (*env)->SetObjectArrayElement(env, ret, i, s);
+        (*env)->DeleteLocalRef(env, s);
+    }
+
+out:
+    es11_smdp_list_free_all(smdp_list);
+    euicc_http_cleanup(ctx);
+    ctx->http.server_address = NULL;  // do not keep a pointer into the released chars
+    (*env)->ReleaseStringUTFChars(env, smds_address, smds);
+    return ret;
+}
+
+// Standalone AuthenticateServer against an arbitrary SM-DP+/SM-DS: challenge →
+// initiateAuthentication → authenticateServer, WITHOUT proceeding to a download. This
+// isolates the CI-trust check the eUICC runs inside the SE: 0 = the server's CI was
+// accepted (production CI); negative = which step failed (a test/foreign-CI server is
+// rejected at authenticateServer, SGP.22 8.8.4/3.7 — visible in the verbose log).
+// The RSP session is cancelled afterward so the eUICC is left clean.
+JNIEXPORT jint JNICALL
+Java_net_typeblog_lpac_1jni_LpacJni_es10bAuthenticate(JNIEnv *env, jobject thiz, jlong handle,
+                                                      jstring server_address) {
+    struct euicc_ctx *ctx = (struct euicc_ctx *) handle;
+    const char *server = (*env)->GetStringUTFChars(env, server_address, NULL);
+    jint rc = 0;
+
+    ctx->http.server_address = (char *) server;
+
+    if (es10b_get_euicc_challenge_and_info(ctx)) { rc = -1; goto out; }
+    if (es9p_initiate_authentication(ctx)) { rc = -2; goto out; }
+    if (es10b_authenticate_server(ctx, NULL, NULL)) { rc = -3; goto out; }
+
+out:
+    // reset any eUICC RSP session opened by a successful authenticateServer (ignore
+    // the return — if no session is open the cancel APDU just errors harmlessly)
+    es10b_cancel_session(ctx, ES10B_CANCEL_SESSION_REASON_UNDEFINED);
+    euicc_http_cleanup(ctx);
+    ctx->http.server_address = NULL;
+    (*env)->ReleaseStringUTFChars(env, server_address, server);
+    return rc;
+}
