  "eUICC_0" -> "LPA_0" [label="GetEUICCChallenge → eC ∈ {0,1}¹²⁸", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "eUICC_1" -> "LPA_1" [label="GetEUICCInfo1 → eInfo1 = ⟨svn, {pkId_CI}⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "LPA_2" -> "SM-DP+_2" [label="ES9+.InitiateAuthentication\n⟨smdpAddr, eC, eInfo1⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "SM-DP+_3" -> "LPA_3" [label="200 ⟨TID, srvSigned1, σ_DP=Sig_{SK.DPauth}(srvSigned1),\nCERT.DPauth, pkId_CI*⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "eUICC_4" -> "eUICC_4" [label="ES10b.AuthenticateServer:\nchk pkId_CI* ∈ trusted ∧ CERT.DPauth ↗ CI\n∧ Vrfy_{PK.DPauth}(σ_DP, srvSigned1)", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, dir=back, headport=e, tailport=e];
  "LPA_5" -> "SM-DP+_5" [label="ES9+.AuthenticateClient\n⟨TID, authServerResp =\n⟨euiccSigned1, σ_eUICC, CERT.eUICC, CERT.EUM⟩⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "SM-DP+_6" -> "LPA_6" [label="200 ⟨TID, profileMetadata, smdpSigned2,\nσ_DP2, CERT.DPpb⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "eUICC_7" -> "eUICC_7" [label="ES10b.PrepareDownload:\nVrfy_{PK.DPpb}(σ_DP2) ⟹\nprepDownloadResp = ⟨euiccSigned2, σ_eUICC2, otPK.eUICC.KA⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, dir=back, headport=e, tailport=e];
  "LPA_8" -> "SM-DP+_8" [label="ES9+.GetBoundProfilePackage\n⟨TID, prepDownloadResp⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "SM-DP+_9" -> "LPA_9" [label="200 ⟨TID, BPP⟩   (ES8+: SCP03t,\nopaque to LPA)", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "eUICC_10" -> "eUICC_10" [label="ES10b.LoadBoundProfilePackage:\nECKA(otPK.DP.KA, otSK.eUICC.KA) → SCP03t keys;\ndecrypt+install PE → ISD-P", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, dir=back, headport=e, tailport=e];
  "LPA_11" -> "SM-DP+_11" [label="ES9+.HandleNotification\n⟨pendingNotification =\n⟨seqNo, σ_eUICC(installResult)⟩⟩", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
  "SM-DP+_12" -> "LPA_12" [label="204 (ack)", color="#1a7f37", fontcolor="#1a7f37", style="solid", constraint=false, penwidth=1.4];
}